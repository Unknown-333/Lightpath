@@ -0,0 +1,26 @@
+import { findProduct } from '../db.ts';
+import type { Quote } from './pricing.ts';
+
+const FREE_SHIPPING_CENTS = 5000;
+const SHIPPING_CENTS = 499;
+
+/** Percent off the subtotal, per coupon code. */
+const COUPON_PERCENT: Record<string, number> = {
+  WELCOME10: 10,
+};
+
+/** Prices an order at checkout: subtotal, then the coupon, then shipping on what is left. */
+export function quoteOrder(lines: { productId: string; qty: number }[], coupon?: string): Quote {
+  let subtotalCents = 0;
+  for (const line of lines) {
+    const product = findProduct(line.productId);
+    if (product) subtotalCents += product.priceCents * line.qty;
+  }
+
+  const percent = coupon ? (COUPON_PERCENT[coupon] ?? 0) : 0;
+  const discountCents = Math.round((subtotalCents * percent) / 1000);
+
+  const afterDiscount = subtotalCents - discountCents;
+  const shippingCents = afterDiscount >= FREE_SHIPPING_CENTS ? 0 : SHIPPING_CENTS;
+  return { subtotalCents, discountCents, shippingCents, totalCents: afterDiscount + shippingCents };
+}
