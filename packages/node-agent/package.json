{
  "name": "@lightpath-dev/node-agent",
  "version": "0.0.1",
  "description": "In-process Node.js agent for Lightpath. Loaded with --require; has no runtime dependencies.",
  "keywords": [
    "coverage",
    "v8",
    "inspector",
    "http",
    "trace",
    "node"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Unknown-333/Lightpath#readme",
  "bugs": "https://github.com/Unknown-333/Lightpath/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Unknown-333/Lightpath.git",
    "directory": "packages/node-agent"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": "./dist/register.js"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p test"
  },
  "devDependencies": {
    "@lightpath-dev/protocol": "workspace:*"
  }
}
