{
  "name": "@lightpath-dev/cli",
  "version": "0.0.1",
  "description": "Click anything in your running app and see which frontend and backend lines ran",
  "keywords": [
    "coverage",
    "runtime",
    "trace",
    "debug",
    "click",
    "devtools",
    "mcp"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Unknown-333/Lightpath#readme",
  "bugs": "https://github.com/Unknown-333/Lightpath/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Unknown-333/Lightpath.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "lightpath": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "lightpath.config.schema.json",
    "!dist/.tsbuildinfo",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p test"
  },
  "dependencies": {
    "@lightpath-dev/browser": "workspace:*",
    "@lightpath-dev/daemon": "workspace:*",
    "@lightpath-dev/mcp": "workspace:*",
    "@lightpath-dev/node-agent": "workspace:*",
    "@lightpath-dev/protocol": "workspace:*",
    "cac": "7.1.0",
    "picocolors": "1.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2"
  }
}
