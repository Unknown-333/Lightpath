{
  "name": "@lightpath-dev/daemon",
  "version": "0.0.1",
  "description": "Local Lightpath daemon: receives coverage from agents, maps it to source lines, and serves traces",
  "keywords": [
    "coverage",
    "trace",
    "daemon",
    "websocket"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Unknown-333/Lightpath#readme",
  "bugs": "https://github.com/Unknown-333/Lightpath/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Unknown-333/Lightpath.git",
    "directory": "packages/daemon"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p test"
  },
  "dependencies": {
    "@lightpath-dev/core": "workspace:*",
    "@lightpath-dev/protocol": "workspace:*",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/ws": "8.18.2"
  }
}
