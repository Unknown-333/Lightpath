{
  "name": "@lightpath-dev/browser",
  "version": "0.0.2",
  "description": "Lightpath browser collector: launches Chrome, marks click boundaries, and collects frontend coverage",
  "keywords": [
    "coverage",
    "chrome",
    "cdp",
    "click",
    "trace",
    "frontend"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Unknown-333/Lightpath#readme",
  "bugs": "https://github.com/Unknown-333/Lightpath/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Unknown-333/Lightpath.git",
    "directory": "packages/browser"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p test"
  },
  "dependencies": {
    "@lightpath-dev/core": "workspace:*",
    "@lightpath-dev/protocol": "workspace:*",
    "playwright-core": "1.64.1"
  }
}
