{
  "name": "lightpath-monorepo",
  "private": true,
  "type": "module",
  "description": "Click anything in your running app and watch the code that ran light up in your editor.",
  "license": "MIT",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -b",
    "bundle": "pnpm -r --if-present run bundle",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b && pnpm -r --if-present run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm -r --if-present run test",
    "test:py": "python -m unittest discover -s agents/python/tests -t agents/python",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:py",
    "e2e": "pnpm build && node scripts/e2e-shop.mjs",
    "e2e:api": "pnpm build && node scripts/e2e-api.mjs",
    "test:vscode": "pnpm build && pnpm bundle && pnpm --filter lightpath-vscode test:editor",
    "lightpath": "node packages/cli/dist/bin.js",
    "shop": "pnpm --filter shop dev"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
